---
import { decodeSlug, getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import { pageSeo } from "../lib/seo";
import { loadSite } from "../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: page, cacheHint }, site] = await Promise.all([getEmDashEntry("pages", slug), loadSite()]);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	for (const hint of site.cacheHints) Astro.cache.set(hint as any);
}
const seo = pageSeo(page, site, false);
---

<Base site={site} {...seo} content={{ collection: "pages", id: page.data.id, slug: page.id }}>
	<PageView page={page} site={site} />
</Base>
