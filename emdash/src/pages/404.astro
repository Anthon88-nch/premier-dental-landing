---
import Base from "../layouts/Base.astro";
import { loadSite } from "../lib/site";

const site = await loadSite();
Astro.response.status = 404;
---

<Base site={site} title="Страница не найдена" robots="noindex, nofollow">
	<main id="main" class="section">
		<div class="wrap">
			<p class="eyebrow">Ошибка 404</p>
			<h1>Такой страницы нет</h1>
			<p class="section__lead">Возможно, ссылка устарела. <a href="/">Вернуться на главную</a> или позвоните нам: <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>.</p>
		</div>
	</main>
</Base>
