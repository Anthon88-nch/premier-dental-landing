---
// 3. Варианты имплантации: карточки с ценой и мини-чертежом.
import Mini from "../art/Mini.astro";
import SectionHead from "../SectionHead.astro";
import { blockEditor, clinicEdit, implantEdit, infoEdit, TURNKEY_INFO } from "../../lib/edit";
import { plain, rich } from "../../lib/text";
import { anchor, linkProps, list, titleId, type BlockProps } from "../../lib/ui";

type Props = BlockProps;
const { value, site, index } = Astro.props;
const t = (text: unknown) => rich(text, site.tokens);
const e = blockEditor(site, value);
const tid = titleId(value, index);
const DRAWINGS: Record<string, string> = {
	"Один имплант": "single",
	"Удаление и имплант": "immediate",
	"All-on-4": "allon4",
	"All-on-6": "allon6",
};

// Цена из одного токена правится там, откуда берётся: {all-on-4} — в «Клинике», {имплант} — у основного импланта.
const priceSource = (raw: unknown, i: number) => {
	const token = String(raw ?? "").trim().match(/^(?:от\s+)?\{([\p{L}\p{N}-]+)\}$/iu)?.[1]?.toLowerCase();
	const clinicField: Record<string, string> = {
		"all-on-4": "allon4_from",
		"коронка": "crown_price",
		"консультация": "consultation_price",
		"доплата": "immediate_extra",
		"вычет": "tax_refund_cap",
	};
	if (token && clinicField[token]) return clinicEdit(site, [clinicField[token]], { t: "int", reload: true });
	if (token === "имплант") return implantEdit(site, site.featured, "implant_price", { t: "int", reload: true });
	if (token === "зуб" || token === "одномоментная") {
		return infoEdit(site, token === "зуб" ? TURNKEY_INFO : `${TURNKEY_INFO} Одномоментная — это ещё плюс доплата из раздела «Клиника».`);
	}
	return e(["items", i, "price"], { reload: true });
};

const cards = list<Record<string, any>>(value.items).map((item, i) => {
	if (!item?.title) return null;
	const price = plain(item.price, site.tokens);
	const from = /^от\s/i.test(price);
	const title = plain(item.title, site.tokens);
	return {
		item,
		i,
		price: from ? price.replace(/^от\s+/i, "") : price,
		from,
		book: price ? `${title} — ${price}` : title,
		drawing: DRAWINGS[item.drawing as string],
		link: item.link_label ? linkProps(item.link_url, "more var__more") : null,
		cardId: typeof item.card_id === "string" && item.card_id.trim() ? item.card_id.trim() : undefined,
	};
});
---

<section class="section" id={anchor(value)} aria-labelledby={tid}>
	<div class="wrap">
		<SectionHead site={site} edit={e} titleId={tid} eyebrow={value.eyebrow} headline={value.headline} lead={value.lead} />
		<ul class="vars">
			{
				cards.map((card) => {
					if (!card) return null;
					const { item, i, price, from, book, drawing, link, cardId } = card;
					const body = (
						<Fragment>
							{item.case && <p class="var__case" {...e(["items", i, "case"])} set:html={t(item.case)} />}
							<h3 class="var__title" {...e(["items", i, "title"], { reload: true })} set:html={t(item.title)} />
							{price && (
								<p class="var__price" {...priceSource(item.price, i)}>
									{from && <small>от</small>}
									{from && " "}
									<span class="num">{price}</span>
								</p>
							)}
							{item.tag && <p class:list={["var__tag", { "var__tag--ink": !item.tag_red }]} {...e(["items", i, "tag"])} set:html={t(item.tag)} />}
							{item.text && <p class="var__text" {...e(["items", i, "text"], { t: "text" })} set:html={t(item.text)} />}
							{item.text_strong && <p class="var__text var__text--strong" {...e(["items", i, "text_strong"], { t: "text" })} set:html={t(item.text_strong)} />}
							{item.time && <p class="var__time" {...e(["items", i, "time"])} set:html={t(item.time)} />}
							{link && <a {...link} {...e(["items", i, "link_label"])} set:html={t(item.link_label)} />}
							{item.cta_label && (
								<button class="btn btn--line btn--sm var__cta" type="button" data-book={book} {...e(["items", i, "cta_label"])} set:html={t(item.cta_label)} />
							)}
						</Fragment>
					);
					return item.wide ? (
						<li class="var var--wide" id={cardId}>
							{drawing && <Mini kind={drawing} wide />}
							<div class="var__body">{body}</div>
						</li>
					) : (
						<li class="var" id={cardId}>
							{drawing && <Mini kind={drawing} />}
							{body}
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
