---
// 13. Вопросы и ответы.
import SectionHead from "../SectionHead.astro";
import { blockEditor } from "../../lib/edit";
import { paragraphs, rich } from "../../lib/text";
import { anchor, list, titleId, type BlockProps } from "../../lib/ui";

type Props = BlockProps;
const { value, site, index } = Astro.props;
const t = (text: unknown) => rich(text, site.tokens);
const e = blockEditor(site, value);
const tid = titleId(value, index);
const items = list<Record<string, any>>(value.items);
const firstShown = items.findIndex((item) => item?.question);
---

<section class="section" id={anchor(value)} aria-labelledby={tid}>
	<div class="wrap faq">
		<SectionHead site={site} edit={e} titleId={tid} eyebrow={value.eyebrow} headline={value.headline} />
		<div class="faq__list">
			{
				items.map((item, i) =>
					item?.question ? (
						<details class="qa" open={(value.open_first && i === firstShown) || site.editing}>
							<summary>
								<span {...e(["items", i, "question"])} set:html={t(item.question)} />
							</summary>
							<div class="qa__a" {...e(["items", i, "answer"], { t: "text", reload: true })}>
								{paragraphs(item.answer).map((p) => (
									<p set:html={t(p)} />
								))}
							</div>
						</details>
					) : null,
				)
			}
		</div>
	</div>
</section>
