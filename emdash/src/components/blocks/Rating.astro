---
// 12. Оценка на ПроДокторов. Цифры — в «Клинике».
import { blockEditor, clinicEdit } from "../../lib/edit";
import { plain, rich, safeHref } from "../../lib/text";
import { anchor, titleId, type BlockProps } from "../../lib/ui";

type Props = BlockProps;
const { value, site, index } = Astro.props;
const t = (text: unknown) => rich(text, site.tokens);
const e = blockEditor(site, value);
const tid = titleId(value, index);
const rating = plain(site.clinic.rating, site.tokens);
const url = safeHref(site.clinic.prodoctorov_url);
---

<section class="rating" id={anchor(value)} aria-labelledby={tid}>
	<div class="wrap rating__in">
		{rating && <p class="rating__score num" aria-hidden="true" {...clinicEdit(site, ["rating"], { reload: true })}>{rating}</p>}
		<div class="rating__copy">
			<h2 id={tid}>
				{rating && <span class="sr">{rating} — </span>}
				<span {...e(["headline"])} set:html={t(value.headline)} />
			</h2>
			{value.text && <p {...e(["text"], { t: "text" })} set:html={t(value.text)} />}
		</div>
		{url && value.button_label && <a class="btn btn--line" href={url} target="_blank" rel="noopener" {...e(["button_label"])} set:html={t(value.button_label)} />}
	</div>
</section>
