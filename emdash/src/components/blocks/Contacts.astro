---
// 14. Контакты и запись. Адрес, часы и телефон — из «Клиники».
import SectionHead from "../SectionHead.astro";
import { rich, safeHref } from "../../lib/text";
import { anchor, titleId, type BlockProps } from "../../lib/ui";

type Props = BlockProps;
const { value, site, index } = Astro.props;
const t = (text: unknown) => rich(text, site.tokens);
const tid = titleId(value, index);
const clinic = site.clinic;
const mapUrl = safeHref(clinic.map_url);
const tel = site.phoneTel ? `tel:${site.phoneTel}` : undefined;
---

<section class="section section--blue contact" id={anchor(value)} aria-labelledby={tid} data-contacts>
	<div class="wrap contact__in">
		<SectionHead site={site} titleId={tid} eyebrow={value.eyebrow} headline={value.headline} lead={value.lead}>
			<div class="contact__actions">
				{value.button_label && <button class="btn btn--red" type="button" data-book="Консультация по имплантации" set:html={t(value.button_label)} />}
				{tel && <a class="btn btn--paper" href={tel}>{site.phoneDisplay}</a>}
			</div>
		</SectionHead>
		<dl class="contact__list">
			{
				clinic.address && (
					<div>
						<dt>Адрес</dt>
						<dd>
							<Fragment set:html={t(clinic.address)} />
							{mapUrl && <br />}
							{mapUrl && <a href={mapUrl} target="_blank" rel="noopener">Построить маршрут в&nbsp;Яндекс Картах</a>}
						</dd>
					</div>
				)
			}
			{
				site.hours.length > 0 && (
					<div>
						<dt>Часы работы</dt>
						<dd set:html={site.hours.map((line) => t(line)).join("<br>")} />
					</div>
				)
			}
			{
				tel && (
					<div>
						<dt>Телефон</dt>
						<dd><a href={tel}>{site.phoneDisplay}</a></dd>
					</div>
				)
			}
			<div data-messengers-row hidden>
				<dt>Мессенджеры</dt>
				<dd class="msgr" data-messengers></dd>
			</div>
		</dl>
	</div>
</section>
