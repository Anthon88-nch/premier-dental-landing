---
// Страница из коллекции «Страницы»: блоки или подсказка, если блоков нет.
import LandingBlocks from "./LandingBlocks.astro";
import type { Site } from "../lib/site";

interface Props {
	page: any;
	site: Site;
}

const { page, site } = Astro.props;
const blocks = Array.isArray(page.data.content) ? page.data.content : [];
---

<main id="main" {...(page.edit?.content ?? {})}>
	{
		blocks.length > 0 ? (
			<LandingBlocks blocks={blocks} site={site} />
		) : (
			<section class="section">
				<div class="wrap">
					<h1>{page.data.title}</h1>
					{Astro.locals.user && (
						<p class="section__lead">
							На странице пока нет блоков. <a href={`/_emdash/admin/content/pages/${page.data.id}`}>Добавить в админке</a>
						</p>
					)}
				</div>
			</section>
		)
	}
</main>
