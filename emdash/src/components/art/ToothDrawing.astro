  <svg class="drawing" viewBox="0 0 364 410" role="img" aria-labelledby="dr-title dr-desc" focusable="false">
    <title id="dr-title">Зуб на импланте в разрезе</title>
    <desc id="dr-desc">{desc}</desc>

