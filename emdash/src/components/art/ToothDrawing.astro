---
// Чертёж «зуб на импланте, разрез А–А» с первого экрана.
// Цены подставляются из «Клиники» (коронка) и основного импланта из «Имплантов».
import { clinicEdit, implantEdit, infoEdit, TURNKEY_INFO } from "../../lib/edit";
import type { Implant, Site } from "../../lib/site";
import { group, money, splitNote } from "../../lib/text";

interface Props {
	site: Site;
	implant: Implant;
	crown: number;
	note?: string | null;
	/** правка подписи у коронки (поле блока «Первый экран») */
	noteEdit?: Record<string, string>;
}

const { site, implant, crown, note: noteText, noteEdit = {} } = Astro.props;
const total = implant.implant + implant.parts + crown;
const note = splitNote(noteText ?? "");
const implantNote = [implant.name, implant.countryShort].filter(Boolean).join(", ");
const rub = (n: number) => `${group(n)} рублей`;
const desc = `Позиция 1 — коронка, ${rub(crown)}${noteText ? `, ${noteText}` : ""}. Позиция 2 — абатмент и формирователь, ${rub(implant.parts)}. Позиция 3 — имплантат ${implantNote}, ${rub(implant.implant)}. Итого ${rub(total)}.`;
