---
// Каркас страницы: шапка, подвал, нижняя панель, окно записи.
// Стили и скрипты лендинга лежат в public/lp — те же, что у статической версии.
import { getMenuWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import EditKit from "../components/EditKit.astro";
import { adminLink, clinicEdit, infoEdit } from "../lib/edit";
import type { Site } from "../lib/site";
import { jsonForScript, plain, rich, safeHref } from "../lib/text";

interface Props {
	site: Site;
	title: string;
	ogTitle?: string;
	ogDescription?: string;
	description?: string;
	image?: string;
	robots?: string;
	content?: { collection: string; id: string; slug?: string | null };
}

const { site, title, ogTitle, ogDescription, description, image, robots, content } = Astro.props;
const { clinic, tokens } = site;

const menuResult = await getMenuWithCacheHint("primary");
if (Astro.cache?.enabled && menuResult.cacheHint) Astro.cache.set(menuResult.cacheHint);
const menu = (menuResult.data?.items ?? []) as Array<{ label: string; url: string; target?: string }>;

const clinicName = plain(clinic.clinic_name, tokens) || "Стоматология «Премьер»";
const ogImage = image || new URL("/lp/media/og.png", Astro.url).href;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title,
	pageTitle: ogTitle ?? title,
	description,
	canonical: `${Astro.url.origin}${Astro.url.pathname}`,
	image: ogImage,
	content,
	seo: { ogTitle, ogDescription, ogImage, robots },
	siteName: clinicName,
});

// Реквизиты в подвале: каждая часть правится на странице отдельно
const legal = [
	{ field: "clinic_name", label: "", strong: true },
	{ field: "legal_name", label: "" },
	{ field: "inn", label: "ИНН " },
	{ field: "ogrn", label: "ОГРН " },
	{ field: "license", label: "Лицензия " },
].filter((part) => typeof clinic[part.field] === "string" && clinic[part.field].trim());
const mainSite = safeHref(clinic.main_site_url);
const bookingHours = site.hours.join(", ");
const configScript = `window.PREMIER_CONFIG = Object.freeze(${jsonForScript(site.config)});`;
const tel = site.phoneTel ? `tel:${site.phoneTel}` : undefined;
const phoneEdit = clinicEdit(site, ["phone_display"], { reload: true });
const menuAdmin = adminLink(site, "/_emdash/admin/menus", "Пункты меню правятся в админке: Меню");
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<EmDashHead page={pageCtx} />
		<meta property="og:locale" content="ru_RU" />
		{!image && <meta property="og:image:width" content="1200" />}
		{!image && <meta property="og:image:height" content="630" />}
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#F4F0E7" />
		<meta name="format-detection" content="telephone=no" />
		<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
		<link rel="preload" href="/assets/manrope-1.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/lp/media/premier-numerals.woff" as="font" type="font/woff" crossorigin />
		<link rel="stylesheet" href="/lp/lp.css" />
		<link rel="stylesheet" href="/lp/emdash.css" />
		<script is:inline src="/lp/lp-head.js"></script>
		<script is:inline set:html={configScript}></script>
		<script is:inline src="/lp/analytics.js" defer></script>
		<script is:inline src="/lp/lp.js" defer></script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip" href="#main">К содержанию</a>

		<!-- Узоры штриховки для всех чертежей страницы. Не display:none — иначе браузеры не рисуют узоры из <defs> -->
		<svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden;color:var(--ink)" aria-hidden="true" focusable="false">
			<defs>
				<pattern id="dr-hatch" width="4.6" height="4.6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path class="dr-hatch" d="M0 0V4.6"></path></pattern>
				<pattern id="dr-bone" width="11" height="11" patternUnits="userSpaceOnUse"><g class="dr-dots"><circle cx="2" cy="3" r="1"></circle><circle cx="7.5" cy="8" r=".8"></circle><circle cx="9.2" cy="2.2" r=".55"></circle><circle cx="4" cy="9.6" r=".5"></circle></g></pattern>
			</defs>
		</svg>

		<header class="head" data-head>
			<div class="head__in wrap">
				<a class="head__brand" href="/#top" aria-label={`${clinicName} — в начало страницы`}>
					<img src="/assets/logo.svg" alt={clinicName} width="327" height="52" />
				</a>
				{
					menu.length > 0 && (
						<nav class="head__nav" aria-label="Разделы страницы">
							{menu.map((item) => (
								<a
									href={safeHref(item.url) ?? "#"}
									target={item.target || undefined}
									rel={item.target === "_blank" ? "noopener" : undefined}
									{...menuAdmin}
									set:html={rich(item.label, tokens)}
								/>
							))}
						</nav>
					)
				}
				{
					tel && (
						<a class="head__phone" href={tel} aria-label={`Позвонить в клинику: ${site.phoneDisplay}`}>
							<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" /></svg>
							<span {...phoneEdit}>{site.phoneDisplay}</span>
						</a>
					)
				}
				<button class="btn btn--red btn--sm head__book" type="button" data-book="Консультация по имплантации">Записаться</button>
			</div>
		</header>

		<slot />

		<footer class="foot">
			{clinic.warning && <p class="foot__warn" {...clinicEdit(site, ["warning"])} set:html={rich(clinic.warning, tokens)} />}
			<div class="wrap foot__in">
				{
					legal.length > 0 && (
						<p>
							{legal.map((part, i) => (
								<Fragment>
									{i > 0 && " · "}
									{part.label}
									{part.strong ? (
										<b {...clinicEdit(site, [part.field], { reload: true })} set:html={rich(clinic[part.field], tokens)} />
									) : (
										<span {...clinicEdit(site, [part.field])} set:html={rich(clinic[part.field], tokens)} />
									)}
								</Fragment>
							))}
						</p>
					)
				}
				{clinic.disclaimer && <p {...clinicEdit(site, ["disclaimer"], { t: "text" })} set:html={rich(clinic.disclaimer, tokens)} />}
				{mainSite && <p><a href={mainSite}>Все услуги клиники</a></p>}
			</div>
		</footer>

		<div class="dock" data-dock hidden>
			{tel && <a class="btn btn--line dock__call" href={tel}>Позвонить</a>}
			<button class="btn btn--red" type="button" data-book="Консультация по имплантации">Записаться</button>
		</div>

		<dialog class="book" id="book" aria-labelledby="book-title">
			<form method="dialog" class="book__close-form"><button class="book__close" aria-label="Закрыть">×</button></form>
			<p class="eyebrow">Запись</p>
			<h2 class="book__title" id="book-title" set:html={rich("Запись на консультацию", tokens)} />
			<p class="book__context" data-book-context hidden></p>
			{clinic.booking_text && <p {...clinicEdit(site, ["booking_text"], { t: "text" })} set:html={rich(clinic.booking_text, tokens)} />}
			<div class="book__actions">
				{tel && <a class="btn btn--red" href={tel}>Позвонить: {site.phoneDisplay}</a>}
				<div class="msgr" data-messengers></div>
			</div>
			{bookingHours && <p class="book__hours" {...infoEdit(site, "Часы берутся из блока «Контакты» — правьте их там.")} set:html={rich(bookingHours, tokens)} />}
		</dialog>

		<p class="toast" role="status" aria-live="polite" data-toast></p>
		{site.editing && <EditKit site={site} />}
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

