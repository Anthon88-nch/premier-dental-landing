# Server is local by default. For hosting use a reverse proxy with HTTPS.
HOST=127.0.0.1
PORT=4173
# Optional HTTPS endpoint of your CRM. Empty = local preview, no external delivery.
LEAD_WEBHOOK_URL=
# Optional bearer token for the CRM endpoint; never put it in frontend files.
LEAD_WEBHOOK_TOKEN=
# Public origin required by your reverse proxy, for example https://example.ru
PUBLIC_ORIGIN=
# Directory for local preview submissions (not served over HTTP).
LEAD_DATA_DIR=./data

# Local administrator. Generate a strong password and salted hash: npm run admin:init
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
